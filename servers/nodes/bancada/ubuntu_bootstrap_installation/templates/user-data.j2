#cloud-config
# ==============================================================================
# LPS / UFRJ - Autoinstall & Cloud-Init Template para Bancadas
# Hostname: {{ node.hostname }} | IP: {{ node.ip }}
# ==============================================================================
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us

  identity:
    hostname: {{ node.hostname }}
    username: {{ common.admin_user }}
    password: "{{ common.admin_password_hash }}"
    realname: "{{ common.admin_realname }}"

  ssh:
    install-server: true
    allow-pw: true
{% if common.admin_ssh_keys %}
    authorized-keys:
{% for key in common.admin_ssh_keys %}
      - "{{ key }}"
{% endfor %}
{% endif %}

  storage:
    layout:
      name: direct

  network:
    network:
      version: 2
      renderer: networkd
      ethernets:
        default-nic:
          match:
            name: "en*"
          dhcp4: false
          addresses:
            - {{ node.ip }}/{{ common.netmask }}
          routes:
            - to: default
              via: {{ common.gateway }}
          nameservers:
            search:
              - {{ common.domain }}
            addresses:
{{ common.dns_block }}

