  packages:
    # Rede e Diagnóstico
    - net-tools
    - curl
    - wget
    - rsync
    - screen
    - htop
    - vim
    - git
    - sshpass
    # Python & Build
    - python3
    - python3-virtualenv
    - python-is-python3
    - build-essential
    # Dependências do Singularity
    - libseccomp-dev
    - squashfs-tools
    - cryptsetup
    - uidmap
    # Docker e Contêineres
    - docker-ce
    - docker-ce-cli
    - containerd.io
    - docker-buildx-plugin
    - docker-compose-plugin
    - nvidia-container-toolkit
    # Armazenamento e Autenticação
    - nfs-common
    - krb5-user
    - libpam-krb5
    - libnss-ldapd
    - libpam-ldapd
    # Acesso Remoto & UI (Tela de Login e XRDP)
    - xrdp
    - dconf-cli

  mounts:
    - [ "{{ common.nfs_marketplace }}", "/mnt/market_place", "nfs", "rsize=32768,wsize=32768,bg,sync,nolock,_netdev,nofail", "0", "0" ]
    - [ "{{ common.nfs_projects }}", "/mnt/shared/storage03/projects", "nfs", "rsize=32768,wsize=32768,bg,sync,nolock,_netdev,nofail", "0", "0" ]
    - [ "{{ common.nfs_homes }}", "/home", "nfs", "rsize=32768,wsize=32768,bg,sync,nolock,_netdev,nofail", "0", "0" ]

  write_files:
    # 1. Configuração Kerberos
    - path: /etc/krb5.conf
      permissions: '0644'
      content: |
        [libdefaults]
            default_realm = {{ common.kerberos_realm }}
            dns_lookup_realm = false
            dns_lookup_kdc = true
            ticket_lifetime = 24h
            renew_lifetime = 7d
            forwardable = true

        [realms]
            {{ common.kerberos_realm }} = {
                kdc = {{ common.kerberos_server }}
                admin_server = {{ common.kerberos_server }}
            }

        [domain_realm]
            .{{ common.domain }} = {{ common.kerberos_realm }}
            {{ common.domain }} = {{ common.kerberos_realm }}

    # 2. Configuração LDAP (nslcd)
    - path: /etc/nslcd.conf
      permissions: '0600'
      content: |
        uid nslcd
        gid nslcd
        uri {{ common.ldap_server_uri }}
        base {{ common.ldap_base_dn }}
        ldap_version 3
        bind_timelimit 10
        timelimit 10
        ssl off

    # 3. NSSwitch para contas de rede
    - path: /etc/nsswitch.conf
      permissions: '0644'
      content: |
        passwd:         files ldap
        group:          files ldap
        shadow:         files ldap
        gshadow:        files

        hosts:          files dns
        networks:       files

        protocols:      db files
        services:       db files
        ethers:         db files
        rpc:            db files

        netgroup:       nis

    # 4. SSH Drop-in moderno LPS
    - path: /etc/ssh/sshd_config.d/60-lps.conf
      permissions: '0644'
      content: |
        # Configurações de autenticação LPS
        GSSAPIAuthentication yes
        GSSAPICleanupCredentials yes
        GSSAPIKeyExchange yes
        KbdInteractiveAuthentication no
        X11Forwarding yes
        UsePAM yes
        PrintMotd no
        AcceptEnv LANG LC_*

    # 5. Configuração do Docker Daemon
    - path: /etc/docker/daemon.json
      permissions: '0644'
      content: |
        {
          "log-driver": "json-file",
          "log-opts": {
            "max-size": "50m",
            "max-file": "3"
          }
        }

    # 6. Serviço de Limpeza Total do Docker no Reboot
    - path: /etc/systemd/system/docker-cleanup-reboot.service
      permissions: '0644'
      content: |
        [Unit]
        Description=Limpeza Total do Docker no Reboot
        After=docker.service
        Requires=docker.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/docker system prune -a --volumes -f

        [Install]
        WantedBy=multi-user.target

    # 7. Configuração da Tela de Login do GDM (Ocultar Usuários e Papel de Parede)
    - path: /etc/dconf/profile/gdm
      permissions: '0644'
      content: |
        user-db:user
        system-db:gdm
        file-db:/usr/share/gdm/greeter-dconf-defaults

    - path: /etc/dconf/db/gdm.d/00-login-screen
      permissions: '0644'
      content: |
        [org/gnome/login-screen]
        disable-user-list=true

    - path: /etc/dconf/db/gdm.d/10-customization-screen
      permissions: '0644'
      content: |
        [com/ubuntu/login-screen]
        background-picture-uri='file:///mnt/market_place/data/login_screen/login_lps_screen.png'
        background-size='cover'
        background-repeat='no-repeat'
        disable-user-list=true

    # 8. Script de Configuração de Fakeroot no Singularity para Usuários LDAP
    - path: /usr/local/bin/configure_singularity_fakeroot.py
      permissions: '0755'
      content: |
        #!/usr/bin/env python3
        import subprocess, sys
        try:
            res = subprocess.run(["getent", "passwd"], capture_output=True, text=True, check=True)
            for line in res.stdout.splitlines():
                parts = line.split(":")
                if len(parts) >= 3:
                    try:
                        uid = int(parts[2])
                        username = parts[0]
                        if 1000 <= uid < 60000 and username != "nobody":
                            subprocess.run(["singularity", "config", "fakeroot", "--add", username], check=False)
                    except ValueError:
                        pass
        except Exception as e:
            print(f"Erro ao configurar fakeroot: {e}", file=sys.stderr)

    # 9. Serviço de Inicialização de Fakeroot pós-boot (quando a rede/LDAP sobem)
    - path: /etc/systemd/system/lps-fakeroot-init.service
      permissions: '0644'
      content: |
        [Unit]
        Description=LPS - Configurar Fakeroot no Singularity para Usuarios LDAP
        After=network-online.target nslcd.service
        Wants=network-online.target nslcd.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/python3 /usr/local/bin/configure_singularity_fakeroot.py

        [Install]
        WantedBy=multi-user.target

    # 10. NTP Nacional
    - path: /etc/systemd/timesyncd.conf
      permissions: '0644'
      content: |
        [Time]
        NTP=1.br.pool.ntp.org 0.br.pool.ntp.org
        FallbackNTP=0.debian.pool.ntp.org 1.debian.pool.ntp.org

    # 11. Script de auditoria de login
    - path: /etc/pam_scripts/login-logger.sh
      permissions: '0755'
      content: |
        #!/bin/sh
        LOG_FILE="/var/log/ssh-auth"
        DATE_ISO=$(date --iso-8601="seconds")
        LOG_ENTRY="[${DATE_ISO}] ${PAM_TYPE}: ${PAM_USER} from ${PAM_RHOST}"
        if [ ! -f ${LOG_FILE} ]; then
            touch ${LOG_FILE}
            chown root:adm ${LOG_FILE}
            chmod 0640 ${LOG_FILE}
        fi
        echo "${LOG_ENTRY}" >> ${LOG_FILE}
        exit 0

  late-commands:
    # 1. Sudo sem senha para cluster
    - echo "{{ common.admin_user }} ALL=(ALL:ALL) NOPASSWD: ALL" > /target/etc/sudoers.d/cluster
    - chmod 440 /target/etc/sudoers.d/cluster

    # 2. Configurar permissões do Docker para o usuário cluster
    - curtin in-target -- usermod -aG sudo,docker cluster

    # 3. Baixar e Instalar o SingularityCE Oficial (Sylabs)
    - curtin in-target -- bash -c 'CODENAME=$(. /etc/os-release && echo "${VERSION_CODENAME:-noble}"); DEB="singularity-ce_4.6.0-${CODENAME}_amd64.deb"; wget -q -O "/tmp/$DEB" "https://github.com/sylabs/singularity/releases/download/v4.6.0/$DEB" || wget -q -O "/tmp/$DEB" "https://github.com/sylabs/singularity/releases/download/v4.6.0/singularity-ce_4.6.0-noble_amd64.deb"; apt-get install -y "/tmp/$DEB"; rm -f "/tmp/$DEB"'

    # 4. Ativar módulo mkhomedir para criar /home no primeiro login
    - curtin in-target -- pam-auth-update --enable mkhomedir

    # 5. Registrar login-logger no PAM do sshd
    - echo "session required pam_exec.so /etc/pam_scripts/login-logger.sh" >> /target/etc/pam.d/sshd

    # 6. Ativar serviços (Limpeza Docker, Fakeroot inicial e XRDP)
    - curtin in-target -- systemctl enable docker.service docker-cleanup-reboot.service lps-fakeroot-init.service xrdp

    # 7. Configurar runtime do NVIDIA Container Toolkit no Docker
    - curtin in-target -- nvidia-ctk runtime configure --runtime=docker || true

    # 8. Compilar banco de dados dconf para aplicar customização da Tela de Login GDM
    - curtin in-target -- dconf update || true
