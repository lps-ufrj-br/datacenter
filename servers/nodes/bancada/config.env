# ==============================================================================
# LPS / UFRJ - Configuração de Ambiente para Scripts Manuais
# Este arquivo é lido por 01_setup_network.sh, 02_install_base.sh, etc.
# ==============================================================================

# Identificação do Nó (Altere conforme a máquina que está configurando)
NODE_HOSTNAME="${NODE_HOSTNAME:-bancada01}"
NODE_IP="${NODE_IP:-146.164.147.201}"
NETMASK="${NETMASK:-24}"
GATEWAY="${GATEWAY:-146.164.147.1}"
DNS_SERVERS="${DNS_SERVERS:-146.164.147.2 8.8.8.8 8.8.4.4}"
DOMAIN="${DOMAIN:-lps.ufrj.br}"

# Interface de rede (deixe vazio para detecção automática da placa física principal)
NET_INTERFACE="${NET_INTERFACE:-}"

# Autenticação Central (Kerberos & LDAP)
KERBEROS_REALM="${KERBEROS_REALM:-LPS.UFRJ.BR}"
KERBEROS_SERVER="${KERBEROS_SERVER:-auth-server.lps.ufrj.br}"
LDAP_SERVER="${LDAP_SERVER:-ldap://auth-server.lps.ufrj.br}"
LDAP_BASE_DN="${LDAP_BASE_DN:-dc=lps,dc=ufrj,dc=br}"

# Armazenamento em Rede (NFS)
NFS_STORAGE_IP="${NFS_STORAGE_IP:-10.1.1.202}"
NFS_PROJECTS_IP="${NFS_PROJECTS_IP:-10.1.1.204}"

NFS_MARKETPLACE="${NFS_MARKETPLACE:-10.1.1.202:/volume1/market_place}"
NFS_PROJECTS="${NFS_PROJECTS:-10.1.1.204:/shares/projects}"
NFS_HOMES="${NFS_HOMES:-10.1.1.202:/volume1/homes}"

# Usuário de Administração Local
ADMIN_USER="${ADMIN_USER:-cluster}"

# Versão do SingularityCE oficial (Sylabs)
SINGULARITY_VERSION="${SINGULARITY_VERSION:-4.6.0}"
